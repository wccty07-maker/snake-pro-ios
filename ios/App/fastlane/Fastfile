default_platform(:ios)

platform :ios do
  desc "Build Signed IPA"
  lane :build_signed_ipa do
    # 1. Configure App Store Connect API Key
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_KEY_ID"],
      issuer_id: ENV["APP_STORE_ISSUER_ID"],
      key_content: ENV["APP_STORE_PRIVATE_KEY"],
      is_key_content_base64: false,
      in_house: false
    )

    # 2. Create isolated temporary keychain on CI runner
    keychain_name = "ci_fastlane_keychain"
    keychain_pwd  = "runner_temporary_password_123"

    delete_keychain(name: keychain_name) rescue nil

    create_keychain(
      name: keychain_name,
      password: keychain_pwd,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    # Resolve absolute path to the created keychain file
    keychain_path = File.expand_path("~/Library/Keychains/#{keychain_name}-db")
    keychain_path = File.expand_path("~/Library/Keychains/#{keychain_name}") unless File.exist?(keychain_path)

    # Pre-install Apple WWDR intermediate certs into the dedicated keychain
    sh("curl -fSL --retry 3 https://www.apple.com/certificateauthority/AppleWWDRCAG3.cer -o /tmp/AppleWWDRCAG3.cer && security import /tmp/AppleWWDRCAG3.cer -k '#{keychain_path}' -T /usr/bin/codesign -T /usr/bin/security") rescue nil
    sh("curl -fSL --retry 3 https://www.apple.com/certificateauthority/AppleWWDRCAG6.cer -o /tmp/AppleWWDRCAG6.cer && security import /tmp/AppleWWDRCAG6.cer -k '#{keychain_path}' -T /usr/bin/codesign -T /usr/bin/security") rescue nil

    require "base64"

    # 3. Retrieve or import Apple Distribution Certificate
    if File.exist?("/tmp/SnakeProSigning.p12")
      UI.message("Found cached signing certificate! Importing /tmp/SnakeProSigning.p12...")
      import_certificate(
        certificate_path: "/tmp/SnakeProSigning.p12",
        certificate_password: keychain_pwd,
        keychain_path: keychain_path,
        keychain_password: keychain_pwd
      )
    elsif ENV["BUILD_CERTIFICATE_BASE64"] && !ENV["BUILD_CERTIFICATE_BASE64"].strip.empty?
      UI.message("Found BUILD_CERTIFICATE_BASE64 secret! Importing existing Distribution Certificate...")
      p12_path = "/tmp/distribution.p12"
      File.binwrite(p12_path, Base64.decode64(ENV["BUILD_CERTIFICATE_BASE64"].strip))
      import_certificate(
        certificate_path: p12_path,
        certificate_password: ENV["P12_PASSWORD"] || "",
        keychain_path: keychain_path,
        keychain_password: keychain_pwd
      )
    else
      UI.message("Retrieving or generating certificate via App Store Connect API...")
      # Auto-cleanup orphaned certificates if 2-certificate limit reached
      begin
        existing_certs = Spaceship::ConnectAPI::Certificate.all(filter: { certificateType: "DISTRIBUTION,IOS_DISTRIBUTION" })
        if existing_certs && existing_certs.count >= 2
          UI.message("Found #{existing_certs.count} existing Distribution certificates on Apple Developer. Checking local keychain...")
          identities = sh("security find-identity -v -p codesigning '#{keychain_path}' || true").strip
          has_matching_key = existing_certs.any? { |c| identities.include?(c.id) || identities.include?(c.serial_number.to_s) }
          unless has_matching_key
            UI.important("No private key found locally for the #{existing_certs.count} existing certificates. Auto-revoking orphaned certificates...")
            existing_certs.each do |c|
              UI.message("Revoking orphaned certificate: #{c.id} (#{c.name})")
              c.delete! rescue nil
            end
            sleep(2)
          end
        end
      rescue => e
        UI.important("Certificate cleanup notice: #{e.message}")
      end

      get_certificates(
        api_key: api_key,
        keychain_path: keychain_path,
        keychain_password: keychain_pwd
      )

      # Export newly generated certificate and private key to a reusable .p12 backup
      sh("security export -k '#{keychain_path}' -t all -f pkcs12 -P '#{keychain_pwd}' -o /tmp/SnakeProSigning.p12") rescue nil
    end

    # Grant codesign permission to private key without interactive prompt
    sh("security set-key-partition-list -S apple-tool:,apple:,codesign: -s -k #{keychain_pwd} \"#{keychain_path}\"") rescue nil

    # 4. Retrieve or create Provisioning Profile
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: "elemall.snakegame.1"
    )

    team_id = ENV["APPLE_TEAM_ID"] || lane_context[SharedValues::SIGH_TEAM_ID] || "N2S5289QDM"
    profile_name = lane_context[SharedValues::SIGH_NAME] || "elemall.snakegame.1 AppStore 1793016646"
    profile_uuid = lane_context[SharedValues::SIGH_UDID]
    UI.message("Apple Developer Team ID: #{team_id}")
    UI.message("Using provisioning profile: #{profile_name} (UUID: #{profile_uuid})")

    # 5. Patch project.pbxproj to ensure manual signing, team, and profile specifier match
    xcodeproj_path = File.exist?("App.xcodeproj") ? "App.xcodeproj" : (File.exist?("../App.xcodeproj") ? "../App.xcodeproj" : Dir["**/App.xcodeproj"].first || "App.xcodeproj")
    patch_script = File.exist?("../../scripts/patch-xcode-signing.py") ? "../../scripts/patch-xcode-signing.py" : (File.exist?("../../../scripts/patch-xcode-signing.py") ? "../../../scripts/patch-xcode-signing.py" : Dir["**/patch-xcode-signing.py"].first)
    if patch_script && File.exist?("#{xcodeproj_path}/project.pbxproj")
      sh("python3 '#{patch_script}' '#{xcodeproj_path}/project.pbxproj' #{team_id} '#{profile_name}'") rescue nil
    end

    begin
      require "xcodeproj"
      proj = Xcodeproj::Project.open(xcodeproj_path)
      proj.targets.each do |target|
        target.build_configurations.each do |config|
          config.build_settings["CODE_SIGN_STYLE"] = "Manual"
          config.build_settings["DEVELOPMENT_TEAM"] = team_id
          config.build_settings["CODE_SIGN_IDENTITY"] = "Apple Distribution"
          config.build_settings["CODE_SIGN_IDENTITY[sdk=iphoneos*]"] = "Apple Distribution"
          config.build_settings["PROVISIONING_PROFILE_SPECIFIER"] = profile_name
          config.build_settings["PROVISIONING_PROFILE"] = profile_uuid if profile_uuid
          if ENV["BUILD_NUMBER"] && !ENV["BUILD_NUMBER"].empty?
            config.build_settings["CURRENT_PROJECT_VERSION"] = ENV["BUILD_NUMBER"]
          end
        end
      end
      proj.root_object.attributes["TargetAttributes"]&.each do |target_id, attrs|
        attrs["DevelopmentTeam"] = team_id
        attrs["ProvisioningStyle"] = "Manual"
      end
      proj.save
      UI.message("App.xcodeproj successfully patched with Xcodeproj for #{profile_name}!")
    rescue => e
      UI.important("Xcodeproj ruby patch note: #{e.message}")
    end

    # 6. Detect workspace or project dynamically
    workspace_file = Dir["*.xcworkspace"].reject { |w| w.include?("project.xcworkspace") }.first
    project_file   = Dir["*.xcodeproj"].first || "App.xcodeproj"

    build_opts = {
      scheme: "App",
      clean: true,
      export_method: "app-store",
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        teamID: team_id,
        provisioningProfiles: {
          "elemall.snakegame.1" => profile_name
        }
      },
      xcargs: "DEVELOPMENT_TEAM=#{team_id} CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY=\"Apple Distribution\" PROVISIONING_PROFILE_SPECIFIER=\"#{profile_name}\" OTHER_CODE_SIGN_FLAGS=\"--keychain #{keychain_path}\"",
      output_directory: "../../build",
      output_name: "SnakePro.ipa"
    }

    if workspace_file && File.exist?(workspace_file)
      UI.message("Building with workspace: #{workspace_file}")
      build_opts[:workspace] = workspace_file
    else
      UI.message("Building with project: #{project_file}")
      build_opts[:project] = project_file
    end

    build_app(build_opts)
  end

  desc "Upload Patched IPA directly to TestFlight"
  lane :upload_ipa do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_KEY_ID"],
      issuer_id: ENV["APP_STORE_ISSUER_ID"],
      key_content: ENV["APP_STORE_PRIVATE_KEY"],
      is_key_content_base64: false,
      in_house: false
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: "../../build/SnakePro.ipa",
      skip_waiting_for_build_processing: true
    )
  end
end
