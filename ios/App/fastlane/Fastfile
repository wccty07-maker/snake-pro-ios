default_platform(:ios)

def get_sanitized_api_key
  raw_key = ENV["APP_STORE_PRIVATE_KEY"].to_s.strip
  key_id = ENV["APP_STORE_KEY_ID"].to_s.strip
  issuer_id = ENV["APP_STORE_ISSUER_ID"].to_s.strip

  UI.message("--- Validating App Store Connect API Credentials ---")
  UI.message("  APP_STORE_KEY_ID: #{key_id.empty? ? 'MISSING ❌' : "[Present: #{key_id}] ✅"}")
  UI.message("  APP_STORE_ISSUER_ID: #{issuer_id.empty? ? 'MISSING ❌' : "[Present: #{issuer_id}] ✅"}")
  UI.message("  APP_STORE_PRIVATE_KEY: #{raw_key.empty? ? 'MISSING ❌' : "[Present, length=#{raw_key.length} chars] ✅"}")

  if key_id.empty? || issuer_id.empty? || raw_key.empty?
    UI.user_error!("Missing App Store Connect credentials in Environment Variables! Please make sure APP_STORE_KEY_ID, APP_STORE_ISSUER_ID, and APP_STORE_PRIVATE_KEY are set in Codemagic.")
  end

  # Auto-fix literal \n backslash escapes and carriage returns
  raw_key = raw_key.gsub('\n', "\n").gsub('\r', "").strip

  # Auto-detect base64 encoded private key
  if !raw_key.include?("BEGIN PRIVATE KEY")
    begin
      require "base64"
      decoded = Base64.decode64(raw_key)
      raw_key = decoded.strip if decoded.include?("BEGIN PRIVATE KEY")
    rescue => e
      UI.message("Base64 decode note: #{e.message}")
    end
  end

  # Ensure PEM header / footer exists
  if !raw_key.include?("BEGIN PRIVATE KEY")
    raw_key = "-----BEGIN PRIVATE KEY-----\n#{raw_key}\n-----END PRIVATE KEY-----"
  end

  app_store_connect_api_key(
    key_id: key_id,
    issuer_id: issuer_id,
    key_content: raw_key,
    is_key_content_base64: false,
    in_house: false
  )
end

def has_valid_distribution_identity?(keychain_path = nil)
  cmd = keychain_path ? "security find-identity -v -p codesigning '#{keychain_path}' 2>/dev/null || true" : "security find-identity -v -p codesigning 2>/dev/null || true"
  output = `#{cmd}`.to_s
  output.include?("Apple Distribution") || output.include?("iPhone Distribution")
end

def collect_and_print_xcode_diagnostics(build_logs_dir)
  require "fileutils"
  FileUtils.mkdir_p(build_logs_dir)

  gym_log_dir = File.expand_path("~/Library/Logs/gym")
  copied_logs = []
  if Dir.exist?(gym_log_dir)
    Dir.glob(File.join(gym_log_dir, "*.log")).each do |src|
      dest = File.join(build_logs_dir, File.basename(src))
      FileUtils.cp(src, dest) rescue nil
      copied_logs << dest if File.exist?(dest)
    end
  end

  Dir.glob(File.join(build_logs_dir, "*.log")).each do |log_file|
    copied_logs << log_file unless copied_logs.include?(log_file)
  end

  copied_logs.uniq.each do |log_path|
    begin
      lines = File.readlines(log_path, encoding: "UTF-8", invalid: :replace, undef: :replace)
      error_lines = lines.select do |line|
        line.match?(/(\berror:|fatal error:|\*\* ARCHIVE FAILED \*\*|\*\* EXPORT FAILED \*\*|CodeSign error|Provisioning profile|does not support provisioning profiles|No signing certificate)/i)
      end
      UI.error("===== Diagnostic Errors Extracted from #{File.basename(log_path)} (#{error_lines.length} matching lines) =====")
      if error_lines.any?
        error_lines.last(80).each { |l| UI.error(l.chomp) }
      else
        UI.error("(No explicit error: lines matched; showing last 80 lines of raw xcodebuild log)")
        lines.last(80).each { |l| UI.error(l.chomp) }
      end
      UI.error("===== End Diagnostic Errors (#{log_path}) =====")
    rescue => read_err
      UI.important("Could not read diagnostic log #{log_path}: #{read_err.message}")
    end
  end
end

platform :ios do
  desc "Build Signed IPA"
  lane :build_signed_ipa do
    require "base64"
    require "fileutils"

    build_output_dir = File.expand_path("../../../build", __dir__)
    build_logs_dir   = File.join(build_output_dir, "logs")
    FileUtils.mkdir_p(build_output_dir)
    FileUtils.mkdir_p(build_logs_dir)

    # 1. Configure App Store Connect API Key
    api_key = get_sanitized_api_key

    # 2. Create isolated temporary keychain on CI runner & include it in user keychain search list
    #    (Avoids passing global OTHER_CODE_SIGN_FLAGS="--keychain ..." to SPM targets!)
    keychain_name = "ci_fastlane_keychain"
    keychain_pwd  = "runner_temporary_password_123"

    delete_keychain(name: keychain_name) rescue nil

    create_keychain(
      name: keychain_name,
      password: keychain_pwd,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    keychain_path = File.expand_path("~/Library/Keychains/#{keychain_name}-db")
    keychain_path = File.expand_path("~/Library/Keychains/#{keychain_name}") unless File.exist?(keychain_path)

    # Ensure CI keychain is first in user search list while keeping existing keychains (e.g. Codemagic keychain) accessible
    existing_keychains = `security list-keychains -d user`.lines.map { |l| l.strip.gsub(/^"|"$/, "") }.reject(&:empty?)
    search_list = ([keychain_path] + existing_keychains).uniq.map { |k| "'#{k}'" }.join(" ")
    sh("security list-keychains -d user -s #{search_list}") rescue nil

    # Pre-install Apple WWDR intermediate certs into the dedicated keychain
    sh("curl -fSL --retry 3 https://www.apple.com/certificateauthority/AppleWWDRCAG3.cer -o /tmp/AppleWWDRCAG3.cer && security import /tmp/AppleWWDRCAG3.cer -k '#{keychain_path}' -T /usr/bin/codesign -T /usr/bin/security") rescue nil
    sh("curl -fSL --retry 3 https://www.apple.com/certificateauthority/AppleWWDRCAG6.cer -o /tmp/AppleWWDRCAG6.cer && security import /tmp/AppleWWDRCAG6.cer -k '#{keychain_path}' -T /usr/bin/codesign -T /usr/bin/security") rescue nil

    # 3. Safe Apple Distribution Certificate Management (V50: NEVER auto-revoke existing certificates!)
    #    Priority:
    #      (a) Reuse valid Distribution identity already installed in local/Codemagic keychain
    #      (b) Import encrypted P12 from BUILD_CERTIFICATE_BASE64 / CM_CERTIFICATE env var
    #      (c) Reuse local /tmp/SnakeProSigning.p12 if present on runner
    #      (d) Query App Store Connect via API ONLY when certificate slots (< 2) allow safe creation
    cert_b64 = ENV["BUILD_CERTIFICATE_BASE64"].to_s.strip
    cert_pwd = ENV["P12_PASSWORD"].to_s
    if cert_b64.empty?
      cert_b64 = ENV["CM_CERTIFICATE"].to_s.strip
      cert_pwd = ENV["CM_CERTIFICATE_PASSWORD"].to_s
    end

    if has_valid_distribution_identity?
      UI.message("Reusing existing valid Apple Distribution signing identity already present in keychain.")
    elsif !cert_b64.empty?
      UI.message("Importing Apple Distribution Certificate (.p12) from encrypted CI environment variable...")
      p12_path = "/tmp/distribution_import.p12"
      begin
        File.binwrite(p12_path, Base64.decode64(cert_b64))
        import_certificate(
          certificate_path: p12_path,
          certificate_password: cert_pwd,
          keychain_path: keychain_path,
          keychain_password: keychain_pwd
        )
      ensure
        File.delete(p12_path) if File.exist?(p12_path)
      end
    elsif File.exist?("/tmp/SnakeProSigning.p12")
      UI.message("Importing cached signing certificate from /tmp/SnakeProSigning.p12...")
      import_certificate(
        certificate_path: "/tmp/SnakeProSigning.p12",
        certificate_password: keychain_pwd,
        keychain_path: keychain_path,
        keychain_password: keychain_pwd
      )
    else
      UI.message("No pre-imported Distribution P12 found locally. Checking Apple Developer certificate slots safely (auto-revocation is DISABLED)...")
      existing_certs = []
      begin
        require "spaceship"
        Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: api_key) if api_key
        existing_certs = Spaceship::ConnectAPI::Certificate.all(filter: { certificateType: "DISTRIBUTION,IOS_DISTRIBUTION" }) || []
      rescue => e
        UI.important("Could not pre-inspect Apple Developer certificates: #{e.message}")
      end

      if existing_certs.count >= 2
        cert_summary = existing_certs.map { |c| "#{c.id} (#{c.name || c.display_name || 'Distribution'})" }.join(", ")
        UI.user_error!(
          "Found #{existing_certs.count} existing Apple Distribution certificates on Apple Developer (#{cert_summary}), " \
          "and no matching private key (.p12) was supplied to this CI runner. " \
          "Automatic certificate revocation has been DISABLED in V50 to protect other apps and pipelines. " \
          "Action required: Export your existing Apple Distribution certificate WITH its private key as a .p12 file " \
          "and configure BUILD_CERTIFICATE_BASE64 + P12_PASSWORD in Codemagic group 'app_store_credentials' " \
          "(or configure Codemagic Code Signing Identities), OR manually revoke an unused certificate in Apple Developer Portal."
        )
      end

      UI.message("Available Distribution certificate slot detected (#{existing_certs.count}/2). Creating/retrieving certificate via App Store Connect API...")
      get_certificates(
        api_key: api_key,
        keychain_path: keychain_path,
        keychain_password: keychain_pwd
      )
    end

    # Grant non-interactive codesign permission on CI keychain (without printing password)
    `security set-key-partition-list -S apple-tool:,apple:,codesign: -s -k '#{keychain_pwd}' '#{keychain_path}' >/dev/null 2>&1`

    unless has_valid_distribution_identity?
      UI.user_error!(
        "No valid 'Apple Distribution' signing identity with private key is available in the keychain after certificate setup. " \
        "Please verify BUILD_CERTIFICATE_BASE64 and P12_PASSWORD in Codemagic."
      )
    end

    # 4. Retrieve or create Provisioning Profile (confirmed official iOS Bundle ID, NO hardcoded temporary profile fallback)
    bundle_id = "elemall.snakegame.1"

    get_provisioning_profile(
      api_key: api_key,
      app_identifier: bundle_id
    )

    team_id = ENV["APPLE_TEAM_ID"] || lane_context[SharedValues::SIGH_TEAM_ID] || "N2S5289QDM"
    profile_name = lane_context[SharedValues::SIGH_NAME].to_s.strip
    profile_uuid = lane_context[SharedValues::SIGH_UDID].to_s.strip

    if profile_name.empty?
      UI.user_error!("Fastlane get_provisioning_profile did not return a provisioning profile name (SIGH_NAME) for #{bundle_id}.")
    end

    UI.message("Apple Developer Team ID: #{team_id}")
    UI.message("Confirmed iOS Bundle ID: #{bundle_id}")
    UI.message("Using dynamic Provisioning Profile: #{profile_name} (UUID: #{profile_uuid})")

    # 4b. Dynamically resolve strictly higher iOS Build Number from App Store Connect
    #     Baseline floor is 253; failed builds (e.g. Build 280) are NOT assumed to exist on TestFlight.
    resolved_build_number = nil
    override_build = ENV["IOS_BUILD_NUMBER_OVERRIDE"].to_s.strip
    if !override_build.empty? && override_build.to_i > 0
      resolved_build_number = override_build.to_i
      UI.message("Using explicit IOS_BUILD_NUMBER_OVERRIDE: #{resolved_build_number}")
    else
      asc_latest = 0
      begin
        asc_latest = latest_testflight_build_number(
          api_key: api_key,
          app_identifier: bundle_id,
          version: "1.0",
          initial_build_number: 231
        ).to_i
        UI.message("App Store Connect latest build number for v1.0 (#{bundle_id}): #{asc_latest}")
      rescue => e
        UI.important("Could not query latest_testflight_build_number (will use safe floor fallback): #{e.message}")
      end

      env_build = ENV["BUILD_NUMBER"].to_s.to_i
      resolved_build_number = [asc_latest + 1, env_build, 253].max
      UI.message("Resolved strictly higher iOS Build Number: #{resolved_build_number}")
    end

    ENV["BUILD_NUMBER"] = resolved_build_number.to_s
    File.write(File.join(build_output_dir, "resolved_build_number.txt"), resolved_build_number.to_s)

    # 5. Patch project.pbxproj STRICTLY for the main application PBXNativeTarget ("App")
    #    and ensure Project-Level buildSettings have ZERO signing/provisioning profile overrides
    #    so Swift Package Manager resource bundles never inherit them.
    xcodeproj_path = File.exist?("App.xcodeproj") ? "App.xcodeproj" : (File.exist?("../App.xcodeproj") ? "../App.xcodeproj" : Dir["**/App.xcodeproj"].first || "App.xcodeproj")
    patch_script = File.exist?("../../scripts/patch-xcode-signing.py") ? "../../scripts/patch-xcode-signing.py" : (File.exist?("../../../scripts/patch-xcode-signing.py") ? "../../../scripts/patch-xcode-signing.py" : Dir["**/patch-xcode-signing.py"].first)
    if patch_script && File.exist?("#{xcodeproj_path}/project.pbxproj")
      sh("python3 '#{patch_script}' '#{xcodeproj_path}/project.pbxproj' '#{team_id}' '#{profile_name}' '#{resolved_build_number}' '#{profile_uuid}'")
    end

    begin
      require "xcodeproj"
      proj = Xcodeproj::Project.open(xcodeproj_path)

      # Strip all signing/provisioning settings from Project-Level build configurations
      project_signing_keys = [
        "PROVISIONING_PROFILE_SPECIFIER",
        "PROVISIONING_PROFILE",
        "CODE_SIGN_STYLE",
        "CODE_SIGN_IDENTITY",
        "CODE_SIGN_IDENTITY[sdk=iphoneos*]",
        "DEVELOPMENT_TEAM",
        "OTHER_CODE_SIGN_FLAGS"
      ]
      proj.build_configurations.each do |config|
        project_signing_keys.each { |k| config.build_settings.delete(k) }
      end

      # Apply Manual Signing strictly to the main application PBXNativeTarget ("App")
      app_targets = proj.native_targets.select do |t|
        t.product_type == "com.apple.product-type.application"
      end
      if app_targets.empty?
        UI.user_error!("Could not find main application PBXNativeTarget in #{xcodeproj_path}")
      end

      app_targets.each do |target|
        target.build_configurations.each do |config|
          config.build_settings["CODE_SIGN_STYLE"] = "Manual"
          config.build_settings["DEVELOPMENT_TEAM"] = team_id
          config.build_settings["CODE_SIGN_IDENTITY"] = "Apple Distribution"
          config.build_settings["CODE_SIGN_IDENTITY[sdk=iphoneos*]"] = "Apple Distribution"
          config.build_settings["PROVISIONING_PROFILE_SPECIFIER"] = profile_name
          config.build_settings["PROVISIONING_PROFILE"] = profile_uuid unless profile_uuid.empty?
          config.build_settings["TARGETED_DEVICE_FAMILY"] = "1"
          config.build_settings["MARKETING_VERSION"] = "1.0"
          config.build_settings["CURRENT_PROJECT_VERSION"] = resolved_build_number.to_s
        end

        attrs = proj.root_object.attributes["TargetAttributes"]&.[](target.uuid)
        if attrs
          attrs["DevelopmentTeam"] = team_id
          attrs["ProvisioningStyle"] = "Manual"
        end
      end

      proj.save
      UI.message("Scoped Manual Signing strictly to main App target(s) (#{app_targets.map(&:name).join(', ')}) for profile '#{profile_name}' (Build #{resolved_build_number}).")
    rescue => e
      UI.important("Xcodeproj ruby patch note: #{e.message}")
    end

    # 6. Detect workspace or project dynamically & archive WITHOUT global signing xcargs!
    #    IMPORTANT (V50): Do NOT pass PROVISIONING_PROFILE_SPECIFIER, PROVISIONING_PROFILE,
    #    CODE_SIGN_STYLE, CODE_SIGN_IDENTITY, DEVELOPMENT_TEAM, or OTHER_CODE_SIGN_FLAGS
    #    in global xcargs — xcodebuild applies xcargs to ALL Swift Package targets, causing
    #    Exit Status 65 on SPM resource bundles (e.g. CapacitorCommunityAdmob_AdMobPlugin,
    #    WebViewNativeUIEngine_WebViewNativeUIEngine).
    workspace_file = Dir["*.xcworkspace"].reject { |w| w.include?("project.xcworkspace") }.first
    project_file   = Dir["*.xcodeproj"].first || "App.xcodeproj"

    build_opts = {
      scheme: "App",
      clean: true,
      export_method: "app-store",
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        teamID: team_id,
        provisioningProfiles: {
          bundle_id => profile_name
        }
      },
      buildlog_path: build_logs_dir,
      suppress_xcode_output: false,
      output_directory: build_output_dir,
      output_name: "SnakePro.ipa"
    }

    if workspace_file && File.exist?(workspace_file)
      UI.message("Building with workspace: #{workspace_file}")
      build_opts[:workspace] = workspace_file
    else
      UI.message("Building with project: #{project_file}")
      build_opts[:project] = project_file
    end

    begin
      build_app(build_opts)
    rescue => build_err
      UI.error("Xcode build_app failed: #{build_err.message}")
      collect_and_print_xcode_diagnostics(build_logs_dir)
      raise build_err
    end
  end

  desc "Upload Patched IPA directly to TestFlight"
  lane :upload_ipa do
    api_key = get_sanitized_api_key

    ipa_path = File.expand_path("../../../build/SnakePro.ipa", __dir__)
    unless File.exist?(ipa_path)
      alt_paths = [
        File.expand_path("../../build/SnakePro.ipa", __dir__),
        File.expand_path("../build/SnakePro.ipa", __dir__),
        "build/SnakePro.ipa"
      ]
      found = alt_paths.find { |p| File.exist?(p) }
      ipa_path = found if found
    end

    UI.message("Uploading IPA from path: #{ipa_path}")

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa_path,
      skip_waiting_for_build_processing: true
    )
  end
end
