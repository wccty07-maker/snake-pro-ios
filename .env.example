# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# iOS AdMob & UMP Testing (Leave unset or false for iOS Release builds)
# Set VITE_IOS_ADMOB_TEST_MODE=true ONLY for local dev/QA builds to use Google's official iOS Rewarded Test Ad Unit ID.
# VITE_IOS_ADMOB_TEST_MODE=false
# Comma-separated hashed test device IDs for iOS AdMob / UMP testing:
# VITE_IOS_ADMOB_TEST_DEVICES=""
# UMP debug geography (EEA | REGULATED_US_STATE | OTHER | DISABLED) - dev/QA only:
# VITE_IOS_UMP_DEBUG_GEOGRAPHY=""

